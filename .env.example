# Run npm run setup to generate the encryption key and an administrator password.
SUBTITLE_DATA_DIR=./data
SUBTITLE_MEDIA_ROOT=
SUBTITLE_MASTER_KEY=
SUBTITLE_ADMIN_HASH=
SUBTITLE_SETUP_TOKEN=
SUBTITLE_PUBLIC_ORIGIN=
SUBTITLE_COOKIE_SECURE=false
# Compose only: host listen address, external origin and read-only media directory.
SUBTITLE_BIND_ADDRESS=127.0.0.1
SUBTITLE_MEDIA_DIR=./media
# Published main image. Forks can replace this with their own GHCR image.
SUBTITLE_IMAGE=ghcr.io/fengyuchen1314/subtitle-workbench:latest
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Never enable globally. Private endpoints must be explicitly allowed per profile.
